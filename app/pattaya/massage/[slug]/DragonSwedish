          background:
            radial-gradient(
              circle at 80% 10%,
              rgba(188, 139, 53, 0.08),
              transparent 30%
            ),
            #101010;
          padding: 28px;
        }

        .price-card-featured {
          border-color: #80602b;
        }

        .price-badge {
          position: absolute;
          top: 18px;
          right: 18px;
          padding: 6px 10px;
          border-radius: 999px;
          background: #d7a844;
          color: #090909;
          font-size: 10px;
          font-weight: 950;
          letter-spacing: 1px;
        }

        .price-top {
          display: flex;
          align-items: center;
          justify-content: space-between;
          border-bottom: 1px solid #252525;
          padding-bottom: 22px;
        }

        .price-letter {
          color: #d6aa5a;
          font-family: Georgia, serif;
          font-size: 72px;
          line-height: 0.8;
          font-weight: 500;
        }

        .price-time {
          padding: 8px 13px;
          border: 1px solid #705426;
          border-radius: 7px;
          color: #d6aa5a;
          font-size: 12px;
          font-weight: 800;
        }

        .price-content {
          padding-top: 22px;
        }

        .price-content h3 {
          margin: 0;
          padding-right: 60px;
          color: #f1f1f1;
          font-size: 19px;
          line-height: 1.5;
        }

        .price-amount {
          display: flex;
          align-items: baseline;
          gap: 8px;
          margin-top: 18px;
        }

        .price-amount span {
          color: #d6aa5a;
          font-size: 42px;
          font-weight: 950;
        }

        .price-amount small {
          color: #aaa;
          font-size: 16px;
        }

        .price-content p {
          margin: 10px 0 0;
          color: #888;
          font-size: 13px;
          line-height: 1.7;
        }

        /* TABLE */

        .simple-price-table {
          margin-top: 30px;
          overflow: hidden;
          border: 1px solid #282828;
          border-radius: 15px;
        }

        .table-row {
          display: grid;
          grid-template-columns: 80px 1fr 100px 120px;
          align-items: center;
          min-height: 65px;
          border-bottom: 1px solid #242424;
        }

        .table-row:last-child {
          border-bottom: 0;
        }

        .table-row > div {
          padding: 14px 18px;
        }

        .table-head {
          background: #151515;
          color: #888;
          font-size: 12px;
          font-weight: 800;
        }

        .table-type {
          color: #d6aa5a;
          font-family: Georgia, serif;
          font-size: 25px;
          font-weight: 900;
        }

        .table-price {
          color: #d6aa5a;
          font-weight: 900;
        }

        /* PROGRAM */

        .program-section {
          border-bottom: 1px solid #181818;
        }

        .program-list {
          margin-top: 30px;
          overflow: hidden;
          border: 1px solid #282828;
          border-radius: 16px;
        }

        .program-item {
          display: grid;
          grid-template-columns: 70px 1fr auto;
          align-items: center;
          gap: 18px;
          padding: 20px;
          border-bottom: 1px solid #242424;
        }

        .program-item:last-child {
          border-bottom: 0;
        }

        .program-icon {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 52px;
          height: 52px;
          border: 1px solid #705426;
          border-radius: 12px;
          color: #d6aa5a;
          font-family: Georgia, serif;
          font-size: 26px;
        }

        .program-item h3 {
          margin: 0;
          font-size: 16px;
        }

        .program-item p {
          margin: 5px 0 0;
          color: #888;
          font-size: 13px;
        }

        .program-item > strong {
          color: #d6aa5a;
          font-size: 20px;
        }

        /* INFO */

        .info-section {
          border-bottom: 1px solid #181818;
        }

        .info-grid {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 14px;
          margin-top: 30px;
        }

        .info-box {
          min-height: 120px;
          padding: 22px;
          border: 1px solid #292929;
          border-radius: 14px;
          background: #101010;
        }

        .info-box span {
          display: block;
          margin-bottom: 12px;
          color: #666;
          font-size: 12px;
        }

        .info-box strong {
          color: #eee;
          font-size: 15px;
          line-height: 1.5;
        }

        /* LOCATION */

        .location-section {
          border-bottom: 1px solid #181818;
        }

        .location-card {
          display: flex;
          align-items: center;
          gap: 20px;
          margin-top: 30px;
          padding: 28px;
          border: 1px solid #292929;
          border-radius: 16px;
          background: #101010;
        }

        .location-icon {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 55px;
          height: 55px;
          flex: 0 0 55px;
          border-radius: 50%;
          background: #191919;
          font-size: 23px;
        }

        .location-card h3 {
          margin: 0;
          font-size: 19px;
        }

        .location-card p {
          margin: 7px 0 0;
          color: #888;
          font-size: 14px;
        }

        .location-warning {
          display: inline-block;
          margin-top: 10px;
          color: #c3913d;
          font-size: 12px;
        }

        /* GUIDE */

        .guide-section {
          border-bottom: 1px solid #181818;
        }

        .guide-list {
          margin-top: 30px;
          display: grid;
          gap: 12px;
        }

        .guide-item {
          display: flex;
          gap: 20px;
          padding: 22px;
          border: 1px solid #292929;
          border-radius: 14px;
          background: #101010;
        }

        .guide-item > span {
          color: #d6aa5a;
          font-family: Georgia, serif;
          font-size: 22px;
          font-weight: 900;
        }

        .guide-item strong {
          font-size: 15px;
        }

        .guide-item p {
          margin: 6px 0 0;
          color: #888;
          font-size: 13px;
          line-height: 1.7;
        }

        /* FAQ */

        .faq-list {
          display: grid;
          gap: 10px;
          margin-top: 30px;
        }

        .faq-list details {
          overflow: hidden;
          border: 1px solid #292929;
          border-radius: 12px;
          background: #101010;
        }

        .faq-list summary {
          padding: 20px;
          cursor: pointer;
          list-style: none;
          font-size: 15px;
          font-weight: 800;
        }

        .faq-list summary::-webkit-details-marker {
          display: none;
        }

        .faq-list details p {
          margin: 0;
          padding: 0 20px 20px;
          color: #888;
          font-size: 13px;
          line-height: 1.8;
        }

        /* CTA */

        .bottom-cta {
          width: min(1180px, calc(100% - 40px));
          margin: 0 auto 80px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 30px;
          padding: 38px;
          border: 1px solid #3b2c17;
          border-radius: 20px;
          background:
            radial-gradient(
              circle at 90% 50%,
              rgba(183, 135, 48, 0.12),
              transparent 35%
            ),
            #0d0c0a;
        }

        .bottom-cta > div:first-child > span {
          color: #d6aa5a;
          font-size: 11px;
          font-weight: 900;
          letter-spacing: 4px;
        }

        .bottom-cta h2 {
          margin: 8px 0 0;
          font-size: 27px;
        }

        .bottom-cta p {
          margin: 8px 0 0;
          color: #777;
          font-size: 13px;
        }

        .cta-buttons {
          display: flex;
          gap: 10px;
          flex-shrink: 0;
        }

        .cta-buttons a {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          min-width: 145px;
          padding: 14px 20px;
          border-radius: 10px;
          text-decoration: none;
          font-size: 13px;
          font-weight: 900;
        }

        .cta-kakao {
          border: 1px solid #c5a300;
          background: #171500;
          color: #ffe500;
        }

        .cta-telegram {
          border: 1px solid #147db4;
          background: #07131a;
          color: #4ab5ef;
        }

        /* MODAL */

        .image-modal {
          position: fixed;
          z-index: 9999;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 30px;
          background: rgba(0, 0, 0, 0.92);
          cursor: zoom-out;
        }

        .image-modal img {
          max-width: min(1200px, 95vw);
          max-height: 90vh;
          object-fit: contain;
          border-radius: 10px;
          box-shadow: 0 20px 80px rgba(0, 0, 0, 0.7);
          cursor: default;
        }

        .modal-close {
          position: fixed;
          z-index: 10000;
          top: 20px;
          right: 25px;
          width: 45px;
          height: 45px;
          border: 1px solid #555;
          border-radius: 50%;
          background: #111;
          color: white;
          font-size: 30px;
          line-height: 1;
          cursor: pointer;
        }

        /* MOBILE */

        @media (max-width: 900px) {
          .gallery-grid {
            grid-template-columns: repeat(2, 1fr);
          }

          .info-grid {
            grid-template-columns: repeat(2, 1fr);
          }

          .bottom-cta {
            flex-direction: column;
            align-items: flex-start;
          }
        }

        @media (max-width: 650px) {
          .hero {
            min-height: 520px;
          }

          .hero-content {
            width: calc(100% - 28px);
            padding-bottom: 50px;
          }

          .hero h1 {
            font-size: 40px;
            letter-spacing: -2px;
          }

          .hero p {
            font-size: 14px;
            line-height: 1.8;
          }

          .section {
            width: calc(100% - 28px);
            padding: 65px 0;
          }

          .section h2 {
            font-size: 32px;
          }

          .gallery-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
          }

          .gallery-card {
            height: 155px;
            border-radius: 10px;
          }

          .gallery-title {
            font-size: 10px;
          }

          .price-grid {
            grid-template-columns: 1fr;
          }

          .price-card {
            padding: 22px;
          }

          .price-letter {
            font-size: 60px;
          }

          .price-amount span {
            font-size: 36px;
          }

          .simple-price-table {
            overflow-x: auto;
          }

          .table-row {
            min-width: 620px;
          }

          .program-item {
            grid-template-columns: 55px 1fr;
          }

          .program-item > strong {
            grid-column: 2;
          }

          .info-grid {
            grid-template-columns: 1fr 1fr;
          }

          .info-box {
            min-height: 105px;
            padding: 17px;
          }

          .location-card {
            align-items: flex-start;
            padding: 20px;
          }

          .bottom-cta {
            width: calc(100% - 28px);
            margin-bottom: 40px;
            padding: 25px;
          }

          .bottom-cta h2 {
            font-size: 22px;
          }

          .cta-buttons {
            width: 100%;
            flex-direction: column;
          }

          .cta-buttons a {
            width: 100%;
          }
        }
      `}</style>
    </>
  );
}
